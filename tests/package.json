{
  "name": "@antikylabs/skills-tests",
  "private": true,
  "type": "module",
  "description": "Test and evaluation harness for the skills in this repository.",
  "scripts": {
    "test": "npm run typecheck && npm run test:unit && npm run test:sandbox && npm run test:skill-behavior",
    "test:sandbox": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs eval/self-test.ts",
    "test:skill-behavior": "node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs eval/run.ts",
    "test:skill-behavior:live": "EVAL_PROVIDER=openrouter node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs eval/run.ts",
    "test:skill-behavior:paired": "EVAL_PROVIDER=openrouter EVAL_BASELINE=1 node --env-file-if-exists=.env node_modules/tsx/dist/cli.mjs eval/run.ts",
    "sandbox:build": "podman build -t antiky-skills-eval -f eval/Dockerfile ..",
    "sandbox:rebuild": "EVAL_REBUILD=1 tsx eval/run.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "tsx --test unit/*.test.ts"
  },
  "comment:overrides": "@aws-sdk/types ^3.974.3 is required somewhere in the pi-ai bedrock provider chain but was never published; 3.974.2 is the newest that exists. Remove this override once the upstream range resolves.",
  "overrides": {
    "@aws-sdk/types": "3.974.2"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.84.1",
    "@earendil-works/pi-ai": "^0.84.1",
    "@oxlint/plugins": "^1.78.0",
    "@types/node": "^22.10.0",
    "oxlint": "^1.78.0",
    "tsx": "^4.23.12",
    "typebox": "^1.3.7",
    "typescript": "^5.7.2"
  }
}
